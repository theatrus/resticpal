<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="resticpal"
           Manufacturer="Yann Ramin"
           Version="$(ProductVersion)"
           UpgradeCode="C10194E3-DD2B-42E2-84E4-0A4CEC84F11C"
           Scope="perMachine"
           InstallerVersion="500"
           Compressed="yes">
    <!-- Install/register the candidate before removing the old product. Stable
         harvested component GUIDs let MSI retain a higher compatible bundled
         .NET patch from the old package instead of costing the lower candidate
         files out and then deleting their only copies during early removal. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of resticpal is already installed."
                  Schedule="afterInstallExecute" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Icon Id="ResticPalIcon.ico" SourceFile="$(BrandIcon)" />
    <Property Id="ARPPRODUCTICON" Value="ResticPalIcon.ico" />
    <Property Id="RESTICPAL_BOOTSTRAP_URL" Hidden="yes" Secure="yes" />
    <!-- Do not let Restart Manager independently relaunch tray or Settings
         command lines during a major upgrade. The package closes affected
         applications, then explicitly launches one tray after InstallFinalize;
         the tray remains the single interactive restart authority. -->
    <Property Id="MSIDISABLERMRESTART" Value="1" />
    <util:CloseApplication Id="CloseResticPalTray"
                           Target="resticpal-tray.exe"
                           CloseMessage="yes"
                           ElevatedCloseMessage="yes"
                           Timeout="5"
                           TerminateProcess="0"
                           RebootPrompt="no" />
    <util:CloseApplication Id="CloseResticPalUi"
                           Target="resticpal-ui.exe"
                           CloseMessage="yes"
                           ElevatedCloseMessage="yes"
                           Timeout="5"
                           TerminateProcess="0"
                           RebootPrompt="no" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="resticpal" />
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="PROGRAMDATADIR" Name="ResticPal" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <Feature Id="Complete" Title="resticpal" Level="1" AllowAdvertise="no">
      <Files Directory="INSTALLFOLDER" Include="$(StageDir)\**">
        <Exclude Files="$(StageDir)\resticpal-service.exe" />
        <Exclude Files="$(StageDir)\resticpal-tray.exe" />
        <Exclude Files="$(StageDir)\resticpal-ui.exe" />
        <!-- These multilingual Windows App SDK binaries list enough LCIDs to
             overflow MSI's File.Language column. Author them explicitly as
             language-neutral; their embedded resources remain unchanged. -->
        <Exclude Files="$(StageDir)\Microsoft.ui.xaml.dll" />
        <Exclude Files="$(StageDir)\Microsoft.UI.Xaml.Phone.dll" />
      </Files>

      <Component Id="WinUiXamlRuntimeComponent"
                 Guid="6980A227-AFF1-42DC-8924-D20E088B076A"
                 Directory="INSTALLFOLDER">
        <File Id="WinUiXamlRuntime"
              Source="$(StageDir)\Microsoft.ui.xaml.dll"
              DefaultLanguage="0"
              KeyPath="yes" />
      </Component>

      <Component Id="WinUiXamlPhoneRuntimeComponent"
                 Guid="904CE951-FF48-46DB-B7B9-D70286467C04"
                 Directory="INSTALLFOLDER">
        <File Id="WinUiXamlPhoneRuntime"
              Source="$(StageDir)\Microsoft.UI.Xaml.Phone.dll"
              DefaultLanguage="0"
              KeyPath="yes" />
      </Component>

      <Component Id="ServiceComponent"
                 Guid="5606D705-0482-413E-B476-B81CA4A0BCF2"
                 Directory="INSTALLFOLDER">
        <File Id="ServiceExecutable"
              Source="$(StageDir)\resticpal-service.exe"
              KeyPath="yes" />
        <ServiceInstall Id="ServiceInstaller"
                        Name="ResticPal"
                        DisplayName="resticpal backup service"
                        Description="Runs machine-wide restic backups and exposes protected local status."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalSystem"
                        Vital="yes">
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="none"
                              RestartServiceDelayInSeconds="30"
                              ResetPeriodInDays="1" />
        </ServiceInstall>
        <ServiceControl Id="ServiceLifecycle"
                        Name="ResticPal"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>

      <Component Id="ProgramDataPermissions"
                 Guid="E00F5551-A672-4A89-8A3C-B4EF509FB47D"
                 Directory="PROGRAMDATADIR"
                 KeyPath="yes">
        <CreateFolder>
          <PermissionEx Sddl="O:SYG:SYD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" />
        </CreateFolder>
      </Component>

      <Component Id="TrayStartup"
                 Guid="17E07A3D-C868-4D1F-9701-0CE3F77B2164"
                 Directory="INSTALLFOLDER">
        <File Id="TrayExecutable"
              Source="$(StageDir)\resticpal-tray.exe" />
        <RegistryValue Root="HKLM"
                       Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="ResticPal"
                       Type="string"
                       Value="&quot;[INSTALLFOLDER]resticpal-tray.exe&quot;"
                       KeyPath="yes" />
      </Component>

      <Component Id="UiExecutableComponent"
                 Guid="D8CE5E44-21ED-476E-AEBD-43AB6D353B87"
                 Directory="INSTALLFOLDER">
        <File Id="UiExecutable"
              Source="$(StageDir)\resticpal-ui.exe"
              KeyPath="yes">
          <Shortcut Id="ResticPalSettingsShortcut"
                    Directory="ProgramMenuFolder"
                    Name="resticpal"
                    Description="Configure and monitor resticpal backups"
                    WorkingDirectory="INSTALLFOLDER"
                    Advertise="yes"
                    Icon="ResticPalIcon.ico" />
        </File>
      </Component>

      <Component Id="BootstrapEnrollment"
                 Guid="4B165580-7EDB-4B74-904D-A31DD91F8BCE"
                 Directory="INSTALLFOLDER"
                 Condition="RESTICPAL_BOOTSTRAP_URL">
        <RegistryKey Root="HKLM"
                     Key="Software\resticpal"
                     ForceCreateOnInstall="yes">
          <RegistryValue Name="BootstrapUrl"
                         Type="string"
                         Value="[RESTICPAL_BOOTSTRAP_URL]"
                         KeyPath="yes" />
          <util:PermissionEx User="BUILTIN\Administrators" GenericAll="yes" />
          <util:PermissionEx User="NT AUTHORITY\SYSTEM" GenericAll="yes" />
        </RegistryKey>
      </Component>

    </Feature>

    <!-- Launch in the installing user's normal desktop token after install,
         upgrade, or repair. The tray itself prevents duplicate instances and
         opens first-run setup when needed. -->
    <Property Id="WixUnelevatedShellExecTarget" Value="[#TrayExecutable]" />
    <CustomAction Id="LaunchTrayAfterInstall"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixUnelevatedShellExec"
                  Execute="immediate"
                  Return="ignore" />
    <InstallExecuteSequence>
      <!-- The util extension defaults CloseApplications immediately before
           InstallFiles, after MSI has already queued RemoveFiles/RemoveFolders.
           Schedule it at the start of the transaction so its deferred
           termination runs before any installed payload is removed. -->
      <Custom Action="override Wix4CloseApplications_$(sys.BUILDARCHSHORT)"
              After="InstallInitialize"
              Condition="VersionNT &gt; 400" />
      <Custom Action="LaunchTrayAfterInstall"
              After="InstallFinalize"
              Condition="NOT (REMOVE ~= &quot;ALL&quot;)" />
    </InstallExecuteSequence>
  </Package>
</Wix>
