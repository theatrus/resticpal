<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RootNamespace>ResticPal.UI</RootNamespace>
    <AssemblyName>resticpal-ui</AssemblyName>
    <ApplicationIcon>..\..\assets\resticpal.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>1.0.2</Version>
    <AssemblyVersion>1.0.2.0</AssemblyVersion>
    <FileVersion>1.0.2.0</FileVersion>
    <InformationalVersion>1.0.2</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>resticpal</AssemblyTitle>
    <Description>Friendly, resilient Windows backups powered by restic.</Description>
    <Company>StackFoundry LLC</Company>
    <Product>resticpal</Product>
    <Copyright>Copyright © 2026 Yann Ramin</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <EmbeddedResource Include="..\..\config\update-public-key.txt"
                      LogicalName="ResticPal.UpdatePublicKey" />
    <Content Include="..\..\assets\resticpal.ico" Link="resticpal.ico"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\assets\resticpal-logo.png" Link="resticpal-logo.png"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="NetSparkleUpdater.SparkleUpdater" Version="3.1.0" />
  </ItemGroup>

  <Target Name="CopyWinUiMarkupToPublishDirectory" AfterTargets="Publish">
    <ItemGroup>
      <_WinUiMarkup Include="$(TargetDir)*.xbf" />
    </ItemGroup>
    <Error Condition="'@(_WinUiMarkup)' == '' or !Exists('$(TargetDir)$(ProjectPriFileName)')"
           Text="The WinUI markup compiler did not produce runtime resources." />
    <Copy SourceFiles="@(_WinUiMarkup)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(ProjectPriFileName)"
          DestinationFiles="$(PublishDir)resources.pri"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
