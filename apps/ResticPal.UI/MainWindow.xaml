<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ResticPal.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="resticpal">

    <NavigationView
        x:Name="NavigationRoot"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="True"
        Loaded="NavigationView_Loaded"
        PaneDisplayMode="Left"
        SelectionChanged="NavigationView_SelectionChanged"
        SelectedItem="{x:Bind OverviewItem}">
        <NavigationView.PaneHeader>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Image Width="32" Height="32" Source="resticpal-logo.png" />
                <TextBlock VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="resticpal" />
            </StackPanel>
        </NavigationView.PaneHeader>
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="OverviewItem" Content="Overview" Tag="overview">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Home" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="SourcesItem" Content="Backup sources" Tag="sources">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Folder" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="RepositoryItem" Content="Repository" Tag="repository">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Save" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="ScheduleItem" Content="Schedule" Tag="schedule">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Calendar" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="RetentionItem" Content="Retention" Tag="retention">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="HistoryItem" Content="History" Tag="history">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Clock" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="RestoreItem" Content="Restore files" Tag="restore">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE777;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="DiagnosticsItem" Content="Diagnostics" Tag="diagnostics">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE9D9;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <ScrollViewer x:Name="OverviewPanel">
                    <Grid Padding="32" RowSpacing="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="6">
                            <TextBlock x:Name="StatusTitle" Style="{StaticResource TitleTextBlockStyle}" Text="Connecting" />
                            <TextBlock x:Name="StatusDescription"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Waiting for the resticpal service"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Border
                            Grid.Row="1"
                            Padding="24"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    FontSize="32"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE753;" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock x:Name="StatusCardTitle" FontSize="18" FontWeight="SemiBold" Text="Service connection pending" />
                                    <TextBlock x:Name="StatusCardDescription"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Waiting for current protection status."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
                            <Button x:Name="RunBackupButton" Click="RunBackupButton_Click" Content="Run backup now" IsEnabled="False" />
                            <Button x:Name="CancelBackupButton" Click="CancelBackupButton_Click" Content="Cancel backup" IsEnabled="False" />
                            <Button
                                x:Name="ViewWarningDetailsButton"
                                Click="ViewWarningDetailsButton_Click"
                                Content="Review backup warning"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <ScrollViewer x:Name="SourcesPanel" Visibility="Collapsed">
                    <Grid MaxWidth="900" Padding="32" HorizontalAlignment="Left" RowSpacing="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Backup sources" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Choose the folders resticpal protects for this PC. Downloads and cloud-only placeholders are not added automatically."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <InfoBar
                            x:Name="SourcesPolicyMessage"
                            Grid.Row="1"
                            IsClosable="False"
                            IsOpen="False"
                            Severity="Informational" />

                        <Border
                            Grid.Row="2"
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <ListView
                                x:Name="BackupPathsList"
                                MinHeight="180"
                                ItemsSource="{x:Bind BackupPaths, Mode=OneWay}"
                                SelectionMode="Single" />
                        </Border>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12">
                            <Button x:Name="DiscoverSourcesButton" Click="DiscoverSourcesButton_Click" Content="Add standard folders" />
                            <Button x:Name="AddSourceButton" Click="AddSourceButton_Click" Content="Add folder…" />
                            <Button x:Name="RemoveSourceButton" Click="RemoveSourceButton_Click" Content="Remove selected" />
                        </StackPanel>

                        <StackPanel Grid.Row="4" Spacing="8">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Exclusions" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Enter one restic exclusion pattern per line."
                                TextWrapping="Wrap" />
                            <TextBox
                                x:Name="ExclusionsBox"
                                AcceptsReturn="True"
                                IsSpellCheckEnabled="False"
                                MinHeight="120"
                                PlaceholderText="**/node_modules/**"
                                TextChanged="SourcesField_Changed"
                                TextWrapping="NoWrap" />
                        </StackPanel>

                        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="12">
                            <Button x:Name="SaveSourcesButton" Click="SaveSourcesButton_Click" Content="Save backup sources" Style="{StaticResource AccentButtonStyle}" />
                            <ProgressRing x:Name="SourcesProgress" IsActive="False" Width="24" Height="24" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <ScrollViewer x:Name="RepositoryPanel" Visibility="Collapsed">
                    <Grid MaxWidth="900" Padding="32" HorizontalAlignment="Left" RowSpacing="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Repository" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Connect this PC to any repository supported by restic. Credentials are protected for the service account and are never displayed again."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <InfoBar
                            x:Name="RepositoryPolicyMessage"
                            Grid.Row="1"
                            IsClosable="False"
                            IsOpen="False"
                            Severity="Informational" />

                        <Border
                            Grid.Row="2"
                            Padding="20"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="16">
                                <InfoBar
                                    x:Name="RepositoryOperationMessage"
                                    IsClosable="False"
                                    IsOpen="True"
                                    Message="Save the repository settings, then test the connection or create a new repository."
                                    Severity="Informational"
                                    Title="Connection not tested" />
                                <TextBox
                                    x:Name="RepositoryDisplayNameBox"
                                    Header="Display name"
                                    MaxLength="256"
                                    PlaceholderText="Office backup"
                                    TextChanged="RepositoryField_Changed" />
                                <ComboBox
                                    x:Name="RepositoryKindBox"
                                    Header="Repository type"
                                    SelectionChanged="RepositoryKindBox_SelectionChanged"
                                    SelectedIndex="0">
                                    <ComboBoxItem Content="Local or network folder" />
                                    <ComboBoxItem Content="S3 or S3-compatible storage" />
                                    <ComboBoxItem Content="Other restic repository" />
                                </ComboBox>
                                <TextBox
                                    x:Name="RepositoryUrlBox"
                                    Header="Repository URL or path"
                                    IsSpellCheckEnabled="False"
                                    PlaceholderText="s3:https://storage.example.com/backups/computer-name"
                                    TextChanged="RepositoryField_Changed" />
                                <StackPanel Spacing="6">
                                    <ComboBox
                                        x:Name="RepositoryModeBox"
                                        Header="Repository behavior"
                                        SelectedIndex="0"
                                        SelectionChanged="RepositoryModeBox_SelectionChanged">
                                        <ComboBoxItem Content="Standard — this PC may apply retention" Tag="standard" />
                                        <ComboBoxItem Content="Append-only — retention is managed elsewhere" Tag="append_only" />
                                    </ComboBox>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Append-only mode prevents this client from pruning or rewriting snapshots. The repository server must perform retention."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBox
                                    x:Name="RepositoryOptionsBox"
                                    AcceptsReturn="True"
                                    Header="Advanced restic options"
                                    IsSpellCheckEnabled="False"
                                    MinHeight="96"
                                    PlaceholderText="s3.connections=5"
                                    TextChanged="RepositoryField_Changed"
                                    TextWrapping="NoWrap" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Optional. Enter one option=value pair per line; resticpal passes each as an --option argument."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Row="3"
                            Padding="20"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="4">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Credentials" />
                                    <TextBlock
                                        x:Name="RepositoryCredentialStatus"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="No stored credentials"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel x:Name="RepositoryCredentialInputs" Spacing="14">
                                    <PasswordBox
                                        x:Name="ResticPasswordBox"
                                        Header="Repository password (RESTIC_PASSWORD)"
                                        PasswordChanged="RepositoryField_Changed"
                                        PasswordRevealMode="Peek" />
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox
                                            x:Name="AwsAccessKeyBox"
                                            Header="AWS access key ID"
                                            PasswordChanged="RepositoryField_Changed"
                                            PasswordRevealMode="Peek" />
                                        <PasswordBox
                                            x:Name="AwsSecretKeyBox"
                                            Grid.Column="1"
                                            Header="AWS secret access key"
                                            PasswordChanged="RepositoryField_Changed"
                                            PasswordRevealMode="Peek" />
                                    </Grid>
                                    <PasswordBox
                                        x:Name="AwsSessionTokenBox"
                                        Header="AWS session token (optional)"
                                        PasswordChanged="RepositoryField_Changed"
                                        PasswordRevealMode="Peek" />
                                    <Expander Header="Other backend credentials">
                                        <StackPanel Padding="0,12,0,0" Spacing="12">
                                            <PasswordBox x:Name="AzureAccountKeyBox" Header="Azure account key" PasswordChanged="RepositoryField_Changed" PasswordRevealMode="Peek" />
                                            <PasswordBox x:Name="B2AccountKeyBox" Header="Backblaze B2 account key" PasswordChanged="RepositoryField_Changed" PasswordRevealMode="Peek" />
                                            <TextBox x:Name="GoogleCredentialsBox" Header="Google application credentials path" IsSpellCheckEnabled="False" TextChanged="RepositoryField_Changed" />
                                            <PasswordBox x:Name="RcloneConfigPasswordBox" Header="rclone configuration password" PasswordChanged="RepositoryField_Changed" PasswordRevealMode="Peek" />
                                        </StackPanel>
                                    </Expander>
                                    <CheckBox
                                        x:Name="RemoveStoredCredentialsCheckBox"
                                        Checked="RepositoryField_Changed"
                                        Unchecked="RepositoryField_Changed"
                                        Content="Remove all currently stored repository credentials when saving" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="12">
                            <Button
                                x:Name="SaveRepositoryButton"
                                Click="SaveRepositoryButton_Click"
                                Content="Save repository"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                x:Name="ValidateRepositoryButton"
                                Click="ValidateRepositoryButton_Click"
                                Content="Test connection" />
                            <Button
                                x:Name="CreateRepositoryButton"
                                Click="CreateRepositoryButton_Click"
                                Content="Create new repository" />
                            <ProgressRing x:Name="RepositoryProgress" IsActive="False" Width="24" Height="24" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <ScrollViewer x:Name="SchedulePanel" Visibility="Collapsed">
                    <Grid MaxWidth="760" Padding="32" HorizontalAlignment="Left" RowSpacing="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Schedule" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Backups use completion-based deadlines and catch up after sleep, shutdown, or a missed interval."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <InfoBar
                            x:Name="SchedulePolicyMessage"
                            Grid.Row="1"
                            IsClosable="False"
                            IsOpen="False"
                            Severity="Informational" />

                        <Border
                            Grid.Row="2"
                            Padding="20"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="18">
                                <NumberBox
                                    x:Name="ScheduleIntervalBox"
                                    Header="Backup interval (hours)"
                                    Maximum="8760"
                                    Minimum="1"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Compact"
                                    ValueChanged="ScheduleNumberField_ValueChanged"
                                    Value="24" />
                                <NumberBox
                                    x:Name="WakeGraceBox"
                                    Header="Wait after wake (minutes)"
                                    Maximum="1440"
                                    Minimum="0"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Compact"
                                    ValueChanged="ScheduleNumberField_ValueChanged"
                                    Value="5" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="An overdue backup waits for this grace period after the PC wakes, giving networking and external drives time to reconnect. Manual backups do not wait."
                                    TextWrapping="Wrap" />
                                <NumberBox
                                    x:Name="WakeLockTimeoutBox"
                                    Header="Keep the PC awake for up to (minutes)"
                                    Maximum="1440"
                                    Minimum="0.0166666667"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Compact"
                                    ValueChanged="ScheduleNumberField_ValueChanged"
                                    Value="120" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="The wake request expires at this safety limit even if restic is still running. It does not terminate the backup."
                                    TextWrapping="Wrap" />
                                <ToggleSwitch
                                    x:Name="AllowBatteryToggle"
                                    Header="Battery power"
                                    IsOn="True"
                                    OffContent="Automatic backups wait for AC power"
                                    OnContent="Allow automatic backups on battery"
                                    Toggled="ScheduleToggle_Toggled" />
                                <ToggleSwitch
                                    x:Name="AllowMeteredToggle"
                                    Header="Metered networks"
                                    IsOn="True"
                                    OffContent="Wait for an unmetered network"
                                    OnContent="Allow backups on metered networks"
                                    Toggled="ScheduleToggle_Toggled" />
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12">
                            <Button
                                x:Name="SaveScheduleButton"
                                Click="SaveScheduleButton_Click"
                                Content="Save schedule"
                                Style="{StaticResource AccentButtonStyle}" />
                            <ProgressRing x:Name="ScheduleProgress" IsActive="False" Width="24" Height="24" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <ScrollViewer x:Name="RetentionPanel" Visibility="Collapsed">
                    <Grid MaxWidth="760" Padding="32" HorizontalAlignment="Left" RowSpacing="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Snapshot retention" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Standard repositories remove expired snapshot references after successful backups and prune unreferenced pack data on a separate cadence."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <InfoBar
                            x:Name="RetentionPolicyMessage"
                            Grid.Row="1"
                            IsClosable="False"
                            IsOpen="False"
                            Severity="Informational" />

                        <Border
                            Grid.Row="2"
                            Padding="20"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="16">
                                <Grid ColumnSpacing="16" RowSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <NumberBox x:Name="RetentionDailyBox" Header="Daily snapshots" Maximum="10000" Minimum="0" SpinButtonPlacementMode="Compact" Value="7" ValueChanged="RetentionNumberField_ValueChanged" />
                                    <NumberBox x:Name="RetentionWeeklyBox" Grid.Column="1" Header="Weekly snapshots" Maximum="10000" Minimum="0" SpinButtonPlacementMode="Compact" Value="5" ValueChanged="RetentionNumberField_ValueChanged" />
                                    <NumberBox x:Name="RetentionMonthlyBox" Grid.Row="1" Header="Monthly snapshots" Maximum="10000" Minimum="0" SpinButtonPlacementMode="Compact" Value="12" ValueChanged="RetentionNumberField_ValueChanged" />
                                    <NumberBox x:Name="RetentionYearlyBox" Grid.Row="1" Grid.Column="1" Header="Yearly snapshots" Maximum="10000" Minimum="0" SpinButtonPlacementMode="Compact" Value="3" ValueChanged="RetentionNumberField_ValueChanged" />
                                </Grid>
                                <NumberBox
                                    x:Name="PruneIntervalBox"
                                    Header="Prune unreferenced data every (days)"
                                    Maximum="365"
                                    Minimum="1"
                                    SpinButtonPlacementMode="Compact"
                                    ValueChanged="RetentionNumberField_ValueChanged"
                                    Value="7" />
                                <TextBlock
                                    x:Name="RetentionLastRunText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Retention has not run yet."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12">
                            <Button
                                x:Name="SaveRetentionButton"
                                Click="SaveRetentionButton_Click"
                                Content="Save retention"
                                Style="{StaticResource AccentButtonStyle}" />
                            <ProgressRing x:Name="RetentionProgress" IsActive="False" Width="24" Height="24" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <Grid
                    x:Name="HistoryPanel"
                    Margin="32"
                    MaxWidth="900"
                    HorizontalAlignment="Stretch"
                    RowSpacing="20"
                    Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Backup history" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Recent outcomes stay on this PC. Warnings can identify a filesystem-consistency issue or unreadable source items. Any retained paths are bounded, visible only in this elevated UI, and never sent in server status or diagnostic logs."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Button
                                x:Name="RefreshHistoryButton"
                                Click="RefreshHistoryButton_Click"
                                Content="Refresh" />
                            <ProgressRing x:Name="HistoryProgress" IsActive="False" Width="24" Height="24" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Border
                            x:Name="HistoryEmptyCard"
                            Padding="28"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel HorizontalAlignment="Center" Spacing="6">
                                <FontIcon FontSize="28" Glyph="&#xE823;" />
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="No backup runs yet" TextAlignment="Center" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Completed, failed, and cancelled backup attempts will appear here."
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <ListView
                            x:Name="HistoryList"
                            ItemsSource="{x:Bind BackupHistory}"
                            SelectionMode="None"
                            Visibility="Collapsed">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,10"
                                        Padding="18"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Headline}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding CompletedAtText}" />
                                            </Grid>
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Summary}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Detail}"
                                                TextWrapping="Wrap" />
                                            <Button
                                                HorizontalAlignment="Left"
                                                Click="ShowRunFailureDetailsButton_Click"
                                                Content="{Binding FailureDetailsButtonText}"
                                                Tag="{Binding}"
                                                Visibility="{Binding FailureDetailsVisibility}" />
                                            <Button
                                                HorizontalAlignment="Left"
                                                Click="BrowseBackupSnapshotButton_Click"
                                                Content="Browse this backup"
                                                Tag="{Binding}"
                                                Visibility="{Binding BrowseSnapshotVisibility}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>

                <ScrollViewer x:Name="RestorePanel" Visibility="Collapsed">
                    <Grid MaxWidth="920" Padding="32" HorizontalAlignment="Stretch" RowSpacing="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Restore files" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Choose an existing backup, browse one file or folder, and restore a verified copy into a new local folder. Existing files are never overwritten."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Button
                                    x:Name="RefreshRestoreButton"
                                    Click="RefreshRestoreButton_Click"
                                    Content="Refresh" />
                                <ProgressRing x:Name="RestorePageProgress" IsActive="False" Width="24" Height="24" />
                            </StackPanel>
                        </Grid>

                        <Border
                            Grid.Row="1"
                            Padding="20"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" Text="Allow file restores on this PC" />
                                    <TextBlock
                                        x:Name="RestoreSettingsDescription"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Only an administrator can browse backup snapshots or restore files."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="RestoreEnabledToggle"
                                    Grid.Column="1"
                                    IsEnabled="False"
                                    OffContent="Off"
                                    OnContent="On"
                                    Toggled="RestoreEnabledToggle_Toggled"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <InfoBar
                            x:Name="RestorePolicyMessage"
                            Grid.Row="2"
                            IsClosable="False"
                            IsOpen="False"
                            Severity="Informational" />

                        <Border
                            x:Name="RestoreSnapshotCard"
                            Grid.Row="3"
                            Padding="20"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="Collapsed">
                            <StackPanel Spacing="16">
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="1. Choose a backup" />
                                <TextBlock
                                    x:Name="RestoreSnapshotSummary"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Loading backups from the repository…"
                                    TextWrapping="Wrap" />
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CalendarDatePicker
                                        x:Name="RestoreDatePicker"
                                        DateChanged="RestoreDatePicker_DateChanged"
                                        Header="Backup date"
                                        PlaceholderText="Select a backup date" />
                                    <ComboBox
                                        x:Name="RestoreSnapshotPicker"
                                        Grid.Column="1"
                                        DisplayMemberPath="DisplayName"
                                        Header="Backup time"
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{x:Bind RestoreSnapshotOptions}"
                                        PlaceholderText="Select a backup"
                                        SelectionChanged="RestoreSnapshotPicker_SelectionChanged" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border
                            x:Name="RestoreBrowserCard"
                            Grid.Row="4"
                            Padding="20"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="Collapsed">
                            <StackPanel Spacing="14">
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="2. Select one file or folder" />
                                <BreadcrumbBar
                                    x:Name="RestoreBreadcrumbBar"
                                    ItemClicked="RestoreBreadcrumbBar_ItemClicked"
                                    ItemsSource="{x:Bind RestoreBreadcrumbs}">
                                    <BreadcrumbBar.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </BreadcrumbBar.ItemTemplate>
                                </BreadcrumbBar>
                                <Grid ColumnSpacing="12" Padding="12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Name" />
                                    <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Size" />
                                    <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="Modified" />
                                </Grid>
                                <ListView
                                    x:Name="RestoreEntriesList"
                                    ItemsSource="{x:Bind RestoreEntries}"
                                    MaxHeight="360"
                                    SelectionChanged="RestoreEntriesList_SelectionChanged"
                                    SelectionMode="Single">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="12" Padding="2,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="72" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="{Binding IconGlyph}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding SizeText}" />
                                                <TextBlock Grid.Column="3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding ModifiedAtText}" />
                                                <Button
                                                    Grid.Column="4"
                                                    Click="OpenRestoreDirectoryButton_Click"
                                                    Content="Open"
                                                    Tag="{Binding}"
                                                    Visibility="{Binding OpenVisibility}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock
                                    x:Name="RestoreDirectoryMessage"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Select a backup to browse its files."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border
                            x:Name="RestoreSelectionCard"
                            Grid.Row="5"
                            Padding="20"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="Collapsed">
                            <StackPanel Spacing="14">
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="3. Choose where to restore" />
                                <TextBlock
                                    x:Name="RestoreSelectionDescription"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Select one file or folder from the backup above."
                                    TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button
                                        x:Name="ChooseRestoreDestinationButton"
                                        Click="ChooseRestoreDestinationButton_Click"
                                        Content="Choose destination" />
                                    <Button
                                        x:Name="StartRestoreButton"
                                        Click="StartRestoreButton_Click"
                                        Content="Restore selected item"
                                        IsEnabled="False"
                                        Style="{StaticResource AccentButtonStyle}" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="RestoreDestinationDescription"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="ResticPal creates a new folder and never replaces existing files."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border
                            x:Name="RestoreProgressCard"
                            Grid.Row="6"
                            Padding="20"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="Collapsed">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="RestoreProgressTitle" FontSize="17" FontWeight="SemiBold" Text="Restore in progress" />
                                <ProgressBar x:Name="RestoreProgressBar" IsIndeterminate="True" />
                                <TextBlock x:Name="RestoreProgressDescription" Text="Preparing the restore…" TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="RestoreProgressDestination"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    IsTextSelectionEnabled="True"
                                    TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button
                                        x:Name="CancelRestoreButton"
                                        Click="CancelRestoreButton_Click"
                                        Content="Cancel restore" />
                                    <Button
                                        x:Name="OpenRestoredFolderButton"
                                        Click="OpenRestoredFolderButton_Click"
                                        Content="Open restored folder"
                                        Visibility="Collapsed" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <Grid
                    x:Name="DiagnosticsPanel"
                    Margin="32"
                    MaxWidth="900"
                    HorizontalAlignment="Stretch"
                    RowSpacing="20"
                    Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Operational diagnostics" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Bounded local events use fixed messages and sanitized codes. Paths, repository URLs, filenames, credentials, and raw restic output are never recorded."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Button x:Name="RefreshDiagnosticsButton" Click="RefreshDiagnosticsButton_Click" Content="Refresh" />
                            <ProgressRing x:Name="DiagnosticsProgress" IsActive="False" Width="24" Height="24" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Border
                            x:Name="DiagnosticsEmptyCard"
                            Padding="28"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel HorizontalAlignment="Center" Spacing="6">
                                <FontIcon FontSize="28" Glyph="&#xE9D9;" />
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="No diagnostic events yet" TextAlignment="Center" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Service lifecycle and backup events will appear here." TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <ListView x:Name="DiagnosticsList" ItemsSource="{x:Bind Diagnostics}" SelectionMode="None" Visibility="Collapsed">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,10"
                                        Padding="18"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Headline}" />
                                                <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding TimestampText}" />
                                            </Grid>
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Message}" TextWrapping="Wrap" />
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Detail}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>

                <ScrollViewer x:Name="ManagementPanel" Visibility="Collapsed">
                    <Grid MaxWidth="760" Padding="32" HorizontalAlignment="Left" RowSpacing="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="6">
                            <InfoBar
                                x:Name="FirstRunInfoBar"
                                IsClosable="False"
                                IsOpen="False"
                                Message="Paste a one-time bootstrap URL below to enroll this PC, or configure backup sources and a repository locally."
                                Severity="Informational"
                                Title="Set up this PC">
                                <InfoBar.ActionButton>
                                    <Button
                                        Click="ConfigureLocallyButton_Click"
                                        Content="Configure locally" />
                                </InfoBar.ActionButton>
                            </InfoBar>
                            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Setup and management" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Enroll this PC with a one-time signed URL to receive policy, repository credentials, and status reporting settings."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Border
                            Grid.Row="1"
                            Padding="20"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="14">
                                <TextBlock x:Name="ManagementStatusTitle" FontSize="17" FontWeight="SemiBold" Text="Checking enrollment" />
                                <TextBlock
                                    x:Name="ManagementStatusDescription"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Waiting for the resticpal service."
                                    TextWrapping="Wrap" />
                                <PasswordBox
                                    x:Name="BootstrapUrlBox"
                                    Header="One-time bootstrap URL"
                                    PasswordRevealMode="Peek"
                                    PlaceholderText="https://backup.example/v1/enroll/...#token=..." />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="The URL is sent only to the local Windows service. Its token is consumed once and is never saved in the configuration file."
                                    TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button
                                        x:Name="EnrollButton"
                                        Click="EnrollButton_Click"
                                        Content="Enroll or rotate"
                                        Style="{StaticResource AccentButtonStyle}" />
                                    <Button
                                        x:Name="UnenrollButton"
                                        Click="UnenrollButton_Click"
                                        Content="Remove management"
                                        IsEnabled="False" />
                                    <ProgressRing x:Name="ManagementProgress" IsActive="False" Width="24" Height="24" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <InfoBar
                            Grid.Row="2"
                            IsClosable="False"
                            IsOpen="True"
                            Message="Removing management keeps repository credentials and existing backups on this PC. It removes the reporting token, device identity key, and cached managed policy."
                            Severity="Informational" />

                        <Border
                            x:Name="UpdateCard"
                            Grid.Row="3"
                            Padding="20"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="4">
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="Application updates" />
                                    <TextBlock
                                        x:Name="UpdateStatusDescription"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Updates are checked against a strictly signed resticpal release feed."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="AutomaticUpdatesToggle"
                                    Header="Install signed updates automatically"
                                    OffContent="Ask before installing"
                                    OnContent="Install silently in the background"
                                    Toggled="AutomaticUpdatesToggle_Toggled" />
                                <InfoBar
                                    x:Name="UpdatePolicyMessage"
                                    IsClosable="False"
                                    IsOpen="False"
                                    Severity="Informational" />
                                <ProgressBar
                                    x:Name="UpdateDownloadProgress"
                                    Maximum="100"
                                    Minimum="0"
                                    Visibility="Collapsed" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button
                                        x:Name="CheckForUpdatesButton"
                                        Click="CheckForUpdatesButton_Click"
                                        Content="Check for updates" />
                                    <Button
                                        x:Name="DownloadUpdateButton"
                                        Click="DownloadUpdateButton_Click"
                                        Content="Download update"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Visibility="Collapsed" />
                                    <Button
                                        x:Name="InstallUpdateButton"
                                        Click="InstallUpdateButton_Click"
                                        Content="Install update"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Visibility="Collapsed" />
                                    <ProgressRing x:Name="UpdateProgress" IsActive="False" Width="24" Height="24" />
                                </StackPanel>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Automatic installation runs through the protected Windows service without UAC or installer prompts. Every MSI must pass the pinned Ed25519 signature check, and a running backup is never interrupted."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <InfoBar
                x:Name="ManagedRefreshInfoBar"
                Grid.Row="1"
                Margin="32,0,32,12"
                IsClosable="False"
                IsOpen="False"
                Severity="Warning">
                <InfoBar.ActionButton>
                    <Button
                        x:Name="DiscardConfigurationEditsButton"
                        Click="DiscardConfigurationEditsButton_Click"
                        Content="Discard edits and refresh" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar
                x:Name="MessageBar"
                Grid.Row="2"
                Margin="32,0,32,20"
                IsClosable="True"
                IsOpen="False" />
        </Grid>
    </NavigationView>
</Window>
